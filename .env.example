# 应用环境：dev / prod
APP_ENV=dev

# 数据库（PostgreSQL 16，compose 暴露在 5433）
DATABASE_URL=postgresql+asyncpg://xianting:xianting@localhost:5433/xianting_chat

# 连接池（可选，下面是默认值）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# DeepSeek（必填，仅聊天接口使用；缺失不阻止应用启动）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7

# JWT（与 Java 版相同，旧 token 继续有效）
APP_JWT_SECRET=xianting-chat-clone-secret-key-change-in-production
APP_JWT_EXPIRE_HOURS=168

# 新用户初始余额
APP_BALANCE_START=100000

# 日志级别
LOG_LEVEL=DEBUG