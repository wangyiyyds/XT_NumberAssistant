<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhufeng.chat.mapper.AgentMapper">

    <resultMap id="BaseResultMap" type="com.zhufeng.chat.entity.Agent">
        <id     column="id"                     property="id"/>
        <result column="public_id"              property="publicId"/>
        <result column="department_id"          property="departmentId"/>
        <result column="name"                   property="name"/>
        <result column="description"            property="description"/>
        <result column="avatar"                 property="avatar"/>
        <result column="category"               property="category"/>
        <result column="is_preset"              property="isPreset"/>
        <result column="conversation_starters"  property="conversationStarters"/>
        <result column="instructions"           property="instructions"/>
        <result column="created_at"             property="createdAt"/>
    </resultMap>

</mapper>
