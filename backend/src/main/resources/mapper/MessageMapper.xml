<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhufeng.chat.mapper.MessageMapper">

    <resultMap id="BaseResultMap" type="com.zhufeng.chat.entity.Message">
        <id     column="id"                property="id"/>
        <result column="public_id"         property="publicId"/>
        <result column="conversation_id"   property="conversationId"/>
        <result column="parent_message_id" property="parentMessageId"/>
        <result column="sender"            property="sender"/>
        <result column="text"              property="text"/>
        <result column="error"             property="error"/>
        <result column="created_at"        property="createdAt"/>
    </resultMap>

</mapper>
