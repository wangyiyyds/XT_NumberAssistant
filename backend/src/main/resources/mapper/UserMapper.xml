<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xianting.chat.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.xianting.chat.entity.User">
        <id     column="id"               property="id"/>
        <result column="public_id"        property="publicId"/>
        <result column="brand"            property="brand"/>
        <result column="email"            property="email"/>
        <result column="password"         property="password"/>
        <result column="name"             property="name"/>
        <result column="avatar"           property="avatar"/>
        <result column="email_verified"   property="emailVerified"/>
        <result column="disabled"         property="disabled"/>
        <result column="contract_read_at" property="contractReadAt"/>
        <result column="created_at"       property="createdAt"/>
    </resultMap>

</mapper>
